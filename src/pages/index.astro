---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Masthead from "@/components/Masthead.astro";
import ElementSearch from "@/components/periodic/ElementSearch.astro";
import FamilyFilter from "@/components/periodic/FamilyFilter.astro";
import PeriodicTable from "@/components/periodic/PeriodicTable.astro";
import TileKey from "@/components/periodic/TileKey.astro";
import SpecimenDialog from "@/components/specimen/SpecimenDialog.astro";
import { getElements, getFamilies } from "@/lib/elements";

const elements = await getElements();
const families = await getFamilies(elements);
const familyLabels = Object.fromEntries(families.map((f) => [f.id, f.data.label]));
const fossils = elements.filter((el) => el.data.family.id === "obsolete").length;
const byTag = (tag: string) => elements.find((el) => el.id === tag)!;
---

<BaseLayout
  title="Tagdex | Every HTML element as a periodic table"
  description={`All ${elements.length} HTML elements arranged like the periodic table. Open any tile for a live specimen.`}
>
  <div class="mx-auto max-w-[84rem] px-4">
    <Masthead living={elements.length - fossils} fossils={fossils} />

    <main id="content">
      <div class="space-y-3 py-3">
        <ElementSearch />
        <FamilyFilter families={families} />
      </div>
      <PeriodicTable elements={elements} featured={byTag("div")} />
      <TileKey sample={byTag("img")} />
    </main>
  </div>

  <SpecimenDialog elements={elements} familyLabels={familyLabels} />
</BaseLayout>

<script>
  import "@/scripts/periodic-table";
  import "@/scripts/specimen-dialog";
</script>

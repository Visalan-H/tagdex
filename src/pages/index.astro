---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
import { COLUMNS, ROWS, placeMain, placeFBlock } from "../lib/layout";
import { demoFor } from "../lib/demos";

const elements = (await getCollection("elements")).sort((a, b) => a.data.n - b.data.n);
const families = (await getCollection("families")).sort(
  (a, b) => elements.findIndex((el) => el.data.family.id === a.id) - elements.findIndex((el) => el.data.family.id === b.id),
);
const main = placeMain(elements);
const fBlock = placeFBlock(elements);
const living = elements.length - fBlock.length;
const featured = elements.find((el) => el.id === "div")!.data;
const sample = elements.find((el) => el.id === "img")!.data;
const familyLabel = Object.fromEntries(families.map((f) => [f.id, f.data.label]));

const cardData = Object.fromEntries(
  elements.map(({ id, data }) => [
    id,
    {
      n: data.n,
      symbol: data.symbol,
      name: data.name,
      family: data.family.id,
      familyLabel: familyLabel[data.family.id],
      void: data.void,
      role: data.role,
      since: data.since,
      attrs: data.attrs,
      replacement: data.replacement ?? null,
      summary: data.summary,
      tip: data.tip,
    },
  ]),
);
---

<Base
  title="Tagdex | Every HTML element as a periodic table"
  description={`All ${elements.length} HTML elements arranged like the periodic table. Click any tile for a live specimen.`}
>
  <header class="masthead">
    <h1 class="wordmark" aria-label="Tagdex">
      <span class="br" aria-hidden="true">&lt;</span><span class="word">Tagdex</span><span class="br" aria-hidden="true">/&gt;</span>
    </h1>
    <p class="tagline">
      Every HTML element, sorted like the periodic table. <strong>{living}</strong> living, <strong>{fBlock.length}</strong> fossils. Click a tile to poke it.
    </p>
  </header>

  <main>
    <nav class="filters" aria-label="Highlight a family">
      {families.map((f) => (
        <button type="button" class="chip" data-family={f.id} aria-pressed="false">
          <span class="dot" />
          {f.data.label}
        </button>
      ))}
    </nav>

    <div class="scroller">
      <div class="board" style={`--cols:${COLUMNS};--rows:${ROWS}`}>
        <ol class="main" aria-label="Living HTML elements">
          {main.map((placed) => <Tile placed={placed} />)}
        </ol>

        <div class="preview block" data-family={featured.family.id} aria-hidden="true">
          <span class="p-n">{featured.n}</span>
          <span class="p-symbol">{featured.symbol}</span>
          <code class="p-tag">&lt;{featured.tag}&gt;</code>
          <span class="p-name">{featured.name}</span>
          <span class="p-summary">{featured.summary}</span>
        </div>

        <p class="hint" aria-hidden="true">hover a tile<br />click to inspect</p>

        <h2 class="f-label">Fossils</h2>
        <ol class="f-block" aria-label="Obsolete HTML elements">
          {fBlock.map((placed) => <Tile placed={placed} />)}
        </ol>
      </div>
    </div>

    <section class="key" aria-labelledby="key-title">
      <h2 id="key-title">How to read a tile</h2>
      <div class="key-row">
        <div class="key-tile block" data-family={sample.family.id} aria-hidden="true">
          <span class="k-n">{sample.n}</span><span class="k-mass">{sample.attrs.length}</span>
          <span class="k-sym">{sample.symbol}</span><code>&lt;{sample.tag}&gt;</code><span class="k-void" />
        </div>
        <ul class="key-list">
          <li><strong>Top left</strong> is the element's number. Numbers run down each column.</li>
          <li><strong>Top right</strong> is atomic mass, the count of attributes only that element accepts.</li>
          <li><strong>The big letters</strong> are its symbol. The label underneath is often the element itself, live.</li>
          <li><strong>A small ring</strong> marks a void element. Like a noble gas, it bonds with nothing.</li>
          <li><strong>Each column</strong> is one family, so neighbors behave alike.</li>
        </ul>
      </div>
    </section>
  </main>

  <dialog class="card block" aria-labelledby="card-title">
    <div class="card-head">
      <span class="c-n"></span>
      <span class="c-symbol"></span>
      <div class="c-titles">
        <span class="c-family"></span>
        <h2 id="card-title"><code class="c-tag"></code> <span class="c-name"></span></h2>
      </div>
      <button type="button" class="c-close" aria-label="Close">×</button>
    </div>
    <div class="card-body">
      <p class="c-summary"></p>
      <div class="specimen">
        <span class="specimen-label">Live specimen</span>
        <div class="specimen-stage"></div>
      </div>
      <p class="c-tip"></p>
      <dl class="facts">
        <div><dt>Since</dt><dd class="c-since"></dd></div>
        <div><dt>Implicit role</dt><dd class="c-role"></dd></div>
        <div><dt>Void</dt><dd class="c-void"></dd></div>
        <div class="c-replacement-row"><dt>Use instead</dt><dd class="c-replacement"></dd></div>
      </dl>
      <div class="c-attrs-wrap">
        <h3>Attributes <span class="c-mass"></span></h3>
        <ul class="c-attrs"></ul>
      </div>
      <a class="c-link" href="#">Open the full page</a>
    </div>
  </dialog>

  {elements.map(({ id, data }) => <template id={`demo-${id}`} set:html={demoFor(id, data.replacement)} />)}
  <script type="application/json" id="card-data" set:html={JSON.stringify(cardData)} />
</Base>

<script>
  type Card = {
    n: number;
    symbol: string;
    name: string;
    family: string;
    familyLabel: string;
    void: boolean;
    role: string | null;
    since: string;
    attrs: string[];
    replacement: string | null;
    summary: string;
    tip: string;
  };

  const data: Record<string, Card> = JSON.parse(document.getElementById("card-data")!.textContent!);
  const board = document.querySelector<HTMLElement>(".board")!;
  const preview = document.querySelector<HTMLElement>(".preview")!;
  const dialog = document.querySelector<HTMLDialogElement>("dialog.card")!;
  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = dialog) => root.querySelector<T>(sel)!;

  // Hover preview in the gap.
  for (const type of ["mouseover", "focusin"]) {
    board.addEventListener(type, (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-tag]");
      if (!link) return;
      const d = data[link.dataset.tag!];
      preview.dataset.family = d.family;
      $(".p-n", preview).textContent = String(d.n);
      $(".p-symbol", preview).textContent = d.symbol;
      $(".p-tag", preview).textContent = `<${link.dataset.tag}>`;
      $(".p-name", preview).textContent = d.name;
      $(".p-summary", preview).textContent = d.summary;
    });
  }

  function drawCanvas(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d")!;
    const colors = ["#ff6b8b", "#ffc94d", "#7be08a", "#6cc6ff", "#b18cff"];
    colors.forEach((color, i) => {
      ctx.beginPath();
      ctx.arc(30 + i * 45, 45, 26, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.globalAlpha = 0.85;
      ctx.fill();
    });
  }

  function open(tag: string) {
    const d = data[tag];
    if (!d) return;
    dialog.dataset.family = d.family;
    $(".c-n").textContent = String(d.n);
    $(".c-symbol").textContent = d.symbol;
    $(".c-family").textContent = d.familyLabel;
    $(".c-tag").textContent = `<${tag}>`;
    $(".c-name").textContent = d.name;
    $(".c-summary").textContent = d.summary;
    $(".c-tip").textContent = d.tip;
    $(".c-since").textContent = d.since;
    $(".c-role").textContent = d.role ?? "None";
    $(".c-void").textContent = d.void ? "Yes, no children" : "No";
    $(".c-replacement-row").hidden = !d.replacement;
    $(".c-replacement").textContent = d.replacement ?? "";
    $(".c-mass").textContent = String(d.attrs.length);
    $(".c-attrs").replaceChildren(
      ...(d.attrs.length ? d.attrs : ["Global attributes only"]).map((a) => {
        const li = document.createElement("li");
        li.textContent = a;
        return li;
      }),
    );
    $<HTMLAnchorElement>(".c-link").href = `/elements/${tag}/`;

    const stage = $(".specimen-stage");
    const template = document.getElementById(`demo-${tag}`) as HTMLTemplateElement;
    stage.replaceChildren(template.content.cloneNode(true));
    stage.querySelectorAll<HTMLCanvasElement>("canvas[data-draw]").forEach(drawCanvas);

    if (!dialog.open) dialog.showModal();
    history.replaceState(null, "", `#${tag}`);
  }

  board.addEventListener("click", (event) => {
    const e = event as MouseEvent;
    const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-tag]");
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    open(link.dataset.tag!);
  });

  $(".c-close").addEventListener("click", () => dialog.close());
  // Clicking the backdrop lands on the dialog itself.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener("close", () => {
    $(".specimen-stage").replaceChildren();
    history.replaceState(null, "", location.pathname);
  });

  if (location.hash) open(decodeURIComponent(location.hash.slice(1)));

  // Family filter chips dim everything else.
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const on = chip.getAttribute("aria-pressed") !== "true";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip && on)));
      if (on) board.dataset.focus = chip.dataset.family;
      else delete board.dataset.focus;
    }),
  );
</script>

<style>
  .masthead,
  main {
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .masthead {
    padding-block: 2.5rem 1rem;
  }

  .wordmark {
    margin: 0;
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--ink-soft);
  }

  @media (prefers-color-scheme: light) {
    .wordmark {
      color: var(--ink);
    }
  }

  .wordmark .br {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.55em;
    vertical-align: 0.25em;
    color: oklch(68% 0.2 350);
  }

  .wordmark .br:last-child {
    color: oklch(72% 0.14 210);
  }

  .tagline {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    font-size: 1.1rem;
  }

  .tagline strong {
    font-weight: 800;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1rem;
  }

  @media (max-width: 40rem) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -1rem;
      padding-inline: 1rem;
    }
  }

  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    font: 600 0.85rem var(--font-display);
    color: var(--ink);
    background: var(--fill);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--shadow);
    cursor: pointer;
    transition: transform 100ms ease, box-shadow 100ms ease;
  }

  .chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .chip[aria-pressed="true"] {
    transform: translate(2px, 2px);
    box-shadow: none;
    outline: 2px solid var(--ink-soft);
    outline-offset: 2px;
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .scroller {
    overflow-x: auto;
    padding: 0.75rem 0.75rem 1.5rem 0.25rem;
  }

  .board {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(3.6rem, 1fr));
    grid-template-rows: repeat(var(--rows), auto) 2rem auto auto;
    gap: 6px;
    min-width: calc(var(--cols) * 3.9rem);
  }

  .main,
  .f-block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    margin: 0;
    padding: 0;
  }

  .main {
    grid-row: 1 / span var(--rows);
  }

  .f-block {
    grid-row: calc(var(--rows) + 2) / span 2;
  }

  .board :global(.tile) {
    transition: opacity 160ms ease, filter 160ms ease;
  }

  .board[data-focus="document"] :global(.tile:not([data-family="document"])),
  .board[data-focus="metadata"] :global(.tile:not([data-family="metadata"])),
  .board[data-focus="sectioning"] :global(.tile:not([data-family="sectioning"])),
  .board[data-focus="grouping"] :global(.tile:not([data-family="grouping"])),
  .board[data-focus="table"] :global(.tile:not([data-family="table"])),
  .board[data-focus="embedded"] :global(.tile:not([data-family="embedded"])),
  .board[data-focus="text"] :global(.tile:not([data-family="text"])),
  .board[data-focus="edits"] :global(.tile:not([data-family="edits"])),
  .board[data-focus="form"] :global(.tile:not([data-family="form"])),
  .board[data-focus="interactive"] :global(.tile:not([data-family="interactive"])),
  .board[data-focus="scripting"] :global(.tile:not([data-family="scripting"])),
  .board[data-focus="obsolete"] :global(.tile:not([data-family="obsolete"])) {
    opacity: 0.18;
    filter: grayscale(1);
  }

  .f-label {
    grid-column: 1;
    grid-row: calc(var(--rows) + 2) / span 2;
    align-self: center;
    justify-self: center;
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  /* Sticker in the gap above the short middle columns, where real tables put the key. */
  .preview {
    grid-column: 6 / span 3;
    grid-row: 1 / span 2;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto auto 1fr;
    column-gap: 0.7rem;
    align-content: start;
    padding: 0.55rem 0.8rem;
    rotate: -1.5deg;
    /* Size comes from the grid area, never from the text, so rows stay even. */
    contain: size;
    pointer-events: none;
    overflow: hidden;
    transition: background-color 160ms ease;
  }

  .p-n {
    grid-column: 1 / -1;
    font: 600 0.7rem var(--font-mono);
  }

  .p-symbol {
    grid-row: 2;
    font-size: 2.8rem;
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .p-tag {
    grid-row: 2;
    align-self: end;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .p-name {
    grid-column: 1 / -1;
    font-weight: 800;
    font-size: 0.95rem;
    margin-top: 0.2rem;
  }

  .p-summary {
    grid-column: 1 / -1;
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .hint {
    grid-column: 9 / span 2;
    grid-row: 1;
    align-self: center;
    margin: 0 0 0 0.5rem;
    font: 500 0.72rem/1.3 var(--font-mono);
    rotate: 3deg;
  }

  .key {
    padding-block: 2rem 4rem;
  }

  .key h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .key-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: center;
  }

  .key-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 8rem;
    aspect-ratio: 1 / 1.1;
    rotate: -3deg;
  }

  .k-n,
  .k-mass {
    position: absolute;
    top: 0.4rem;
    font: 600 0.9rem var(--font-mono);
  }

  .k-n {
    left: 0.6rem;
  }

  .k-mass {
    right: 0.6rem;
    opacity: 0.6;
  }

  .k-sym {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1;
  }

  .k-void {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .key-list {
    flex: 1 1 22rem;
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }

  .key-list strong {
    font-weight: 800;
  }

  /* Specimen card */
  .card {
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    overflow: auto;
    background: var(--card);
    box-shadow: 10px 10px 0 var(--shadow);
  }

  .card[open] {
    animation: pop 220ms cubic-bezier(0.3, 1.5, 0.6, 1);
  }

  .card::backdrop {
    background: oklch(20% 0.03 285 / 0.55);
    backdrop-filter: blur(3px);
  }

  @keyframes pop {
    from {
      transform: translateY(16px) scale(0.94) rotate(-2deg);
      opacity: 0;
    }
  }

  .card-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--fill);
    border-bottom: 2.5px solid var(--ink);
  }

  .c-n {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    font: 700 0.8rem var(--font-mono);
  }

  .c-symbol {
    grid-column: 1;
    grid-row: 1 / span 2;
    padding-top: 0.9rem;
    font-size: 4rem;
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .c-titles {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .c-family {
    font: 600 0.75rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card h2 {
    margin: 0.1rem 0 0;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .c-tag {
    font-size: 0.85em;
  }

  .c-close {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    width: 2.25rem;
    height: 2.25rem;
    font: 700 1.4rem/1 var(--font-display);
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 50%;
    box-shadow: 2px 2px 0 var(--ink);
    cursor: pointer;
  }

  .c-close:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .card-body {
    padding: 1.1rem 1.25rem 1.4rem;
  }

  .c-summary {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    line-height: 1.4;
    font-weight: 500;
  }

  .specimen {
    position: relative;
    margin-bottom: 1rem;
    border: 2px dashed var(--ink);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(45deg, transparent 0 10px, oklch(94% 0.01 85) 10px 11px),
      oklch(98.5% 0.005 85);
  }

  .specimen-label {
    position: absolute;
    top: -0.75rem;
    left: 0.8rem;
    padding: 0.05rem 0.5rem;
    font: 700 0.7rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--fill);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .specimen-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.4rem 1rem 1rem;
    overflow-x: auto;
    font-family: system-ui, sans-serif;
  }

  .c-tip {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-left: 5px solid var(--ink);
    background: oklch(95% 0.06 100);
    border-radius: 0 8px 8px 0;
  }

  .c-tip::before {
    content: "Tip. ";
    font-weight: 800;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .facts div {
    padding: 0.45rem 0.65rem;
    border: 2px solid var(--ink);
    border-radius: 8px;
  }

  .facts dt {
    font: 600 0.68rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
  }

  .c-attrs-wrap h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .c-mass {
    display: inline-block;
    min-width: 1.6rem;
    padding: 0 0.4rem;
    margin-left: 0.25rem;
    text-align: center;
    font: 700 0.8rem/1.5 var(--font-mono);
    background: var(--fill);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .c-attrs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .c-attrs :global(li) {
    padding: 0.1rem 0.5rem;
    font: 500 0.78rem var(--font-mono);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    background: oklch(97% 0.01 85);
  }

  .c-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-weight: 800;
    text-decoration: none;
    background: var(--fill);
    border: 2.5px solid var(--ink);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .c-link:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card[open] {
      animation: none;
    }
  }

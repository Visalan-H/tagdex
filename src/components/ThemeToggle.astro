---
import Moon from "@tabler/icons/outline/moon.svg";
import Sun from "@tabler/icons/outline/sun.svg";
import { Button } from "@/components/starwind/button";
---

<Button
  data-theme-toggle
  variant="outline"
  size="icon"
  aria-label="Switch to dark theme"
  class="fixed top-[max(1rem,env(safe-area-inset-top))] right-[max(1rem,env(safe-area-inset-right))] z-40 rounded-full border-2 border-foreground bg-card text-card-foreground shadow-hard-sm hover:-translate-px hover:bg-card hover:text-card-foreground hover:shadow-hard active:translate-0.5 active:shadow-none"
>
  <Moon class="size-5 dark:hidden" aria-hidden="true" />
  <Sun class="hidden size-5 dark:block" aria-hidden="true" />
</Button>

<script>
  import { initThemeToggle } from "@/scripts/theme";

  initThemeToggle();
</script>

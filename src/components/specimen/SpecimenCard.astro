---
import "@/styles/specimen-demos.css";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import type { ElementEntry } from "@/lib/elements";
import { demoFor } from "@/lib/specimen-demos";

interface Props {
  element: ElementEntry;
  familyLabel: string;
  /** h1 on the element's own page, h2 inside the dialog. */
  headingLevel?: "h1" | "h2";
  showPageLink?: boolean;
}

const { element, familyLabel, headingLevel = "h2", showPageLink = true } = Astro.props;
const d = element.data;
const Heading = headingLevel;
const titleId = `specimen-title-${element.id}`;
const summaryId = `specimen-summary-${element.id}`;
const facts = [
  { label: "Since", value: d.since },
  { label: "Implicit role", value: d.role ?? "None" },
  { label: "Void", value: d.void ? "Yes, no children" : "No" },
  ...(d.replacement ? [{ label: "Use instead", value: d.replacement }] : []),
];
---

<article data-family={d.family.id} data-title-id={titleId} data-summary-id={summaryId} class="text-card-foreground">
  <header class="grid grid-cols-[auto_1fr] items-end gap-x-4 border-b-[2.5px] border-ink bg-(--fill) px-5 pt-3 pb-4 pr-14 text-ink">
    <span class="col-span-2 text-sm font-semibold tabular-nums">{d.n}</span>
    <span class="text-6xl leading-[0.9] font-extrabold tracking-tighter" aria-hidden="true">
      {d.symbol}
    </span>
    <div>
      <p class="text-sm font-semibold">{familyLabel}</p>
      <Heading id={titleId} class="text-2xl leading-tight font-extrabold tracking-tight">
        <code translate="no" class="font-mono text-[0.85em]">
          &lt;{d.tag}&gt;
        </code>{" "}
        {d.name}
      </Heading>
    </div>
  </header>

  <div class="space-y-5 px-5 pt-4 pb-6">
    <p id={summaryId} class="text-lg leading-snug font-medium">
      {d.summary}
    </p>

    <figure class="relative m-0 rounded-xl border-2 border-dashed border-ink bg-[repeating-linear-gradient(45deg,transparent_0_10px,#eef2f8_10px_11px)] bg-white">
      <figcaption class="absolute -top-3 left-3 rounded-full border-2 border-ink bg-(--fill) px-2 text-xs font-bold text-ink">
        Live specimen
      </figcaption>
      <div class="specimen-stage" set:html={demoFor(element.id, d.replacement)} />
    </figure>

    <p class="rounded-r-lg border-l-[5px] border-ink bg-[oklch(95%_0.06_100)] px-4 py-3 text-ink">
      <strong class="font-extrabold">Tip.</strong> {d.tip}
    </p>

    <dl class="grid grid-cols-[repeat(auto-fit,minmax(8rem,1fr))] gap-2.5">
      {facts.map((fact) => (
        <div class="rounded-lg border-2 border-ink px-3 py-2">
          <dt class="text-xs font-semibold text-card-foreground/70">{fact.label}</dt>
          <dd class="font-bold">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <section aria-label="Attributes">
      <h3 class="mb-2 flex items-center gap-2 font-extrabold">
        Attributes
        <Badge size="sm" class="border-2 border-ink bg-(--fill) font-bold text-ink tabular-nums">
          {d.attrs.length}
        </Badge>
      </h3>
      {d.attrs.length ? (
        <ul class="flex flex-wrap gap-1.5">
          {d.attrs.map((attr) => (
            <li>
              <Badge variant="outline" size="sm" class="rounded-md border-ink/60 font-mono text-card-foreground">
                {attr}
              </Badge>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-card-foreground/70">Global attributes only.</p>
      )}
    </section>

    {showPageLink && (
      <Button
        as="a"
        href={`/elements/${element.id}/`}
        class="rounded-full border-[2.5px] border-ink bg-(--fill) font-extrabold text-ink shadow-hard-sm hover:bg-(--fill) active:translate-0.5 active:shadow-none"
      >
        Open the full page
      </Button>
    )}
  </div>
</article>

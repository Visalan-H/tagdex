---
import type { ElementEntry } from "@/lib/elements";

interface Props {
  element: ElementEntry;
}

const d = Astro.props.element.data;
---

<!-- Visual echo of the hovered tile. Screen readers already hear the tile itself. -->
<div
  data-preview
  data-family={d.family.id}
  aria-hidden="true"
  class="pointer-events-none col-[6/span_3] row-[1/span_2] grid grid-cols-[auto_1fr] content-start gap-x-3 overflow-hidden rounded-xl border-[2.5px] border-ink bg-(--fill) px-3.5 py-2.5 text-ink shadow-hard transition-colors duration-150 contain-size"
>
  <span data-field="n" class="col-span-2 text-xs font-semibold tabular-nums">
    {d.n}
  </span>
  <span data-field="symbol" class="row-start-2 text-5xl leading-[0.95] font-extrabold tracking-tight">
    {d.symbol}
  </span>
  <code data-field="tag" class="row-start-2 self-end font-mono text-sm font-semibold">
    &lt;{d.tag}&gt;
  </code>
  <span data-field="name" class="col-span-2 mt-1 text-base leading-tight font-extrabold">
    {d.name}
  </span>
  <span data-field="summary" class="col-span-2 text-[0.78rem] leading-snug">
    {d.summary}
  </span>
</div>

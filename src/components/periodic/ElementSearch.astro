---
import { Input } from "@/components/starwind/input";
import { Kbd } from "@/components/starwind/kbd";
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <div class="relative w-full max-w-xs">
    <label for="element-search" class="sr-only">
      Find an element
    </label>
    <Input
      id="element-search"
      type="search"
      size="sm"
      name="q"
      placeholder="Find an element, like dialog…"
      autocomplete="off"
      spellcheck="false"
      data-element-search
      class="h-10 rounded-full border-2 border-foreground bg-card! pr-10 pl-4 text-card-foreground shadow-hard-sm placeholder:text-card-foreground/55"
    />
    <Kbd
      class="absolute top-1/2 hidden sm:inline-flex right-3 -translate-y-1/2 border border-ink/30 bg-white text-ink"
      aria-hidden="true"
    >
      /
    </Kbd>
  </div>
  <p data-search-status role="status" aria-live="polite" class="text-sm text-muted-foreground"></p>
</div>

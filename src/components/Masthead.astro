---
interface Props {
  living: number;
  fossils: number;
}

const { living, fossils } = Astro.props;
---

<header class="pt-10 pb-4">
  <!-- prettier-ignore -->
  <h1 class="text-balance text-[clamp(3rem,9vw,6.5rem)] leading-[0.9] font-extrabold tracking-[-0.045em]"><span aria-hidden="true" class="align-[0.25em] font-mono text-[0.55em] font-bold text-[oklch(68%_0.2_350)]">&lt;</span>Tagdex<span aria-hidden="true" class="align-[0.25em] font-mono text-[0.55em] font-bold text-[oklch(72%_0.14_210)]">/&gt;</span></h1>
  <p class="mt-3 max-w-xl text-lg text-pretty text-muted-foreground">
    Every HTML element, sorted like the periodic table. <strong class="font-extrabold text-foreground">{living}</strong>{" "}
    living and <strong class="font-extrabold text-foreground">{fossils}</strong> fossils. Open any tile to try the
    element out.
  </p>
</header>
